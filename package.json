{
  "name": "pz-icon-maker",
  "version": "1.3.0",
  "description": "Render Project Zomboid 3D item models to inventory icons that match the in-game look.",
  "author": "AlexVDefi",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/AlexVDefi/rcpz-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexVDefi/rcpz-tools.git"
  },
  "main": "src/app.js",
  "scripts": {
    "start": "electron .",
    "build:ui": "cd web && npm run build:desktop",
    "start:desktop": "npm run build:ui && electron .",
    "cli": "node src/cli.js",
    "dist:studio": "npm run build:ui && electron-builder --config electron-builder-studio.json",
    "dist:iconmaker": "electron-builder --config electron-builder-iconmaker.json",
    "dist": "npm run dist:studio && npm run dist:iconmaker",
    "postinstall": "node scripts/vendor-three.js"
  },
  "dependencies": {
    "assimpjs": "^0.0.10",
    "gifenc": "^1.0.3",
    "koffi": "^2.9.0",
    "sharp": "^0.33.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  }
}
