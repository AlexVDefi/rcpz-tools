{
  "name": "pz-icon-maker",
  "version": "1.0.1",
  "description": "Render Project Zomboid 3D item models to inventory icons that match the in-game look.",
  "author": "AlexVDefi",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/AlexVDefi/pz-icon-maker",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexVDefi/pz-icon-maker.git"
  },
  "main": "src/app.js",
  "scripts": {
    "start": "electron .",
    "cli": "node src/cli.js",
    "dist": "electron-builder --win zip",
    "postinstall": "node scripts/vendor-three.js"
  },
  "dependencies": {
    "koffi": "^2.9.0",
    "sharp": "^0.33.5",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.alexvdefi.pziconmaker",
    "productName": "pz-icon-maker",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor"
      }
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**",
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "pz-icon-maker-${version}-win-x64.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "extraFiles": [
      {
        "from": "build/pz-icon-maker-cli.cmd",
        "to": "pz-icon-maker-cli.cmd"
      }
    ]
  }
}
