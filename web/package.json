{
  "name": "pz-icon-maker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser (Chromium) build of pz-icon-maker: reads your local PZ install + workshop mods via the File System Access API and renders characters and item icons in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "assimpjs": "^0.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.169.0",
    "@tanstack/react-virtual": "^3.10.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
