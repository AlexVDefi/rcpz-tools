{
  "name": "pz-character-studio",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "description": "PZ Survivor Studio: a Chromium web app that reads your local Project Zomboid install + workshop mods via the File System Access API to browse, dress, pose, animate and export characters, and import a look from a save. Fully client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-virtual": "^3.10.8",
    "assimpjs": "^0.0.10",
    "gifenc": "^1.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
