# Optional online-sharing feature. Leave these unset to build a 100% local app (no auth, no
# uploads, connect-src stays locked to 'self'). Set all three to enable sign-in + cloud sharing.
# Copy to .env.local for local dev, and add the same vars to your Vercel project settings.

# Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base URL of the Cloudflare Worker that stores + serves shared renders (its custom domain).
# The same origin handles /upload, /object and /f/<key>.
VITE_CLOUD_API=https://share.YOUR-DOMAIN.com
