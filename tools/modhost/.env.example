# rcpz-tools modder-hosting backend env. On the box: copy to `.env`, fill in the secrets, then
# `systemctl restart rcpz-modhost`. NEVER commit the real .env (it is gitignored).

PORT=8790
SWEEP_MS=180000
MAX_ATTEMPTS=3

# Supabase (same project as the app). service_role bypasses RLS to read + update mod_permissions.
SUPABASE_URL=https://dkivmjidqzcgmarazcth.supabase.co
SUPABASE_SERVICE_ROLE=PASTE_SUPABASE_SERVICE_ROLE_KEY

# Shared secret the Worker sends in the x-modhost-secret header when it pings /host.
MODHOST_SECRET=PASTE_A_LONG_RANDOM_STRING

# R2 (same bucket as vanilla assets); an Object Read & Write token.
R2_ACCOUNT_ID=aa73c0228c55cbb9c4ddf320b02529a1
R2_ACCESS_KEY_ID=PASTE_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=PASTE_R2_SECRET_ACCESS_KEY
R2_BUCKET=rcpz-assets

# Where mods are downloaded from + served.
STEAMCMD=/opt/steamcmd/steamcmd.sh
PUBLIC_ASSET_BASE=https://assets.rcpz.tools
